# Daimon Live — Broadcast Configuration
# Copy to muse-live.env and fill in your values:
#   cp broadcast/muse-live.env.example broadcast/muse-live.env
#   chmod 600 broadcast/muse-live.env
#
# IMPORTANT: muse-live.env contains your stream key — never commit it to git.

# ===========================================================================
# REQUIRED
# ===========================================================================

# YouTube RTMP stream key — get from YouTube Studio > Go Live > Stream Settings
# Format: xxxx-xxxx-xxxx-xxxx-xxxx
YOUTUBE_STREAM_KEY=your-youtube-stream-key

# ===========================================================================
# Broadcast Page
# ===========================================================================

# URL Chrome will load — use localhost for local access
# Append ?voice=<preset> to select Daimon voice preset (see src/lib/constants.ts)
# Available presets: radio, ghost, interdimensional, oracle, void, original, clean
BROADCAST_URL=http://localhost:8151/broadcast?voice=radio

# ===========================================================================
# Display & Encoding
# ===========================================================================

DISPLAY_NUM=99
RESOLUTION=1280x720
FRAMERATE=30

# YouTube recommends 2500-6500k for 720p30
VIDEO_BITRATE=4000k
AUDIO_BITRATE=128k

# Slow audio by this percentage (deepens pitch — e.g. 4 = -4% speed, ~70 cents lower).
# Leave unset or 0 for unmodified audio.
# AUDIO_SLOWDOWN_PERCENT=0

# ===========================================================================
# Security
# ===========================================================================

# Secret for broadcast REST API — prevents unauthorized injection
# Generate with: openssl rand -base64 32
BROADCAST_SECRET=change-me-to-a-random-string

# ===========================================================================
# Optional — Proxy
# ===========================================================================

# HTTP proxy URL for Chrome — useful for VPN routing.
# Leave empty to connect directly.
# HTTP_PROXY_URL=http://your-proxy-host:1080

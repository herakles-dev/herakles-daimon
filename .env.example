# Herakles Daimon — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables without defaults are REQUIRED.
# Variables with defaults are optional — change them to customize.

# ===========================================================================
# REQUIRED — Core Secrets
# ===========================================================================

# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Database password — choose a strong random string
POSTGRES_PASSWORD=change-me-to-a-random-string

# ===========================================================================
# Application Configuration
# ===========================================================================

# Your public domain (used for CORS and YouTube embed origin)
# Set to http://localhost:8151 for local development
APP_DOMAIN=your-domain.com

# WebSocket URL for the frontend to reach the backend
# For production: wss://your-domain.com/ws/gemini
# For local dev: ws://localhost:8150/ws/gemini
NEXT_PUBLIC_WS_URL=ws://localhost:8150/ws/gemini

# Public app origin for YouTube IFrame Player API
# Must match what YouTube sees in the iframe's `origin` parameter
# For local dev: http://localhost:8151
# For production: https://your-domain.com
NEXT_PUBLIC_APP_ORIGIN=http://localhost:8151

# CORS allowed origins — comma-separated list
# For production: https://your-domain.com,http://localhost:8151
CORS_ORIGINS=http://localhost:8151

# ===========================================================================
# Database
# ===========================================================================

# Full database connection URL (overrides POSTGRES_* vars if set)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://play:change-me-to-a-random-string@db:5432/daimon_play

# PostgreSQL credentials (used by docker-compose healthcheck)
POSTGRES_DB=daimon_play
POSTGRES_USER=play
# POSTGRES_PASSWORD set above (REQUIRED)

# ===========================================================================
# Gemini Model
# ===========================================================================

# Gemini Live API model to use
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Max concurrent Gemini Live sessions
MAX_GEMINI_SESSIONS=5

# ===========================================================================
# Ports
# ===========================================================================

# Backend API port (FastAPI)
BACKEND_PORT=8150

# Frontend port (Next.js)
FRONTEND_PORT=8151

# ===========================================================================
# Music / Upload
# ===========================================================================

# Jamendo API client ID — get your own at https://developer.jamendo.com
# The value below is a public demo ID with limited rate limits.
JAMENDO_CLIENT_ID=your-jamendo-client-id

# Max upload sizes in MB
MAX_UPLOAD_SIZE_MB=200
MAX_ZIP_SIZE_MB=500

# ===========================================================================
# Broadcast Feature (optional — only needed for YouTube livestream)
# ===========================================================================

# YouTube RTMP stream key — get from YouTube Studio > Live Dashboard
# Format: xxxx-xxxx-xxxx-xxxx-xxxx
# YOUTUBE_STREAM_KEY=your-youtube-stream-key

# Broadcast page URL (must be accessible by Chrome on the same machine)
# BROADCAST_URL=http://localhost:8151/broadcast?voice=ghost

# Secret to authenticate broadcast API calls (generate a random string)
# BROADCAST_SECRET=change-me-to-a-random-string

# If OAuth auto-detect fails, set the active broadcast video ID manually
# BROADCAST_VIDEO_ID=your-video-id

# Display settings for Xvfb
# DISPLAY_NUM=99
# RESOLUTION=1280x720
# FRAMERATE=30
# VIDEO_BITRATE=4000k
# AUDIO_BITRATE=128k

# ===========================================================================
# Google OAuth (optional — for YouTube chat bridge and Super Chat support)
# ===========================================================================

# Google OAuth2 credentials — create at https://console.cloud.google.com
# Enable "YouTube Data API v3" and create OAuth2 credentials.
# GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Path where YouTube OAuth tokens are stored inside the container
# Mount the file into the container via docker-compose volumes.
# YOUTUBE_TOKEN_PATH=/secrets/youtube_tokens.json

# ===========================================================================
# Optional — Proxy (for datacenter deployments)
# ===========================================================================

# HTTP proxy URL for Chrome and yt-dlp.
# Leave empty to connect directly.
# Example: http://your-proxy-host:1080
# SOCKS_PROXY=http://your-proxy-host:1080

# HTTP proxy for Chrome in broadcast mode (can differ from SOCKS_PROXY)
# HTTP_PROXY_URL=http://your-proxy-host:1080

# ===========================================================================
# Optional — Advanced
# ===========================================================================

# Gemini model used for auto-tagging videos/tracks (default: gemini-2.0-flash)
# GEMINI_TAGGING_MODEL=gemini-2.0-flash

# Music storage path inside the container (default: /music)
# MUSIC_STORAGE_PATH=/music

# Model cache directory for embeddings (default: /tmp/model_cache)
# MODEL_CACHE_DIR=/tmp/model_cache

# Music pipeline concurrency for batch operations (default: 3)
# MUSIC_PIPELINE_CONCURRENCY=3

# Openverse API access token — for Creative Commons media search
# https://api.openverse.org/v1/auth_tokens/register/
# OPENVERSE_ACCESS_TOKEN=your-openverse-token


# Backend port override for frontend broadcast WS connection
# NEXT_PUBLIC_BACKEND_PORT=8150

# Logging level (default: INFO). Set to DEBUG for development.
# LOG_LEVEL=INFO
